# ============================================================================
# ENVIRONMENT
# ============================================================================
FLASK_ENV=production
FLASK_DEBUG=0

# ============================================================================
# DATABASE (PostgreSQL for Production)
# ============================================================================
# Local Development (SQLite):
# DATABASE_URL=sqlite:///whatsapp_crm.db

# Production (PostgreSQL - Render/Heroku/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# Note: Render/Heroku automatically provide DATABASE_URL
DATABASE_URL=sqlite:///whatsapp_crm.db

# ============================================================================
# SECURITY
# ============================================================================
# CRITICAL: Generate a strong secret key for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ============================================================================
# META WHATSAPP CLOUD API
# ============================================================================
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_APP_SECRET=your_app_secret_here

# ============================================================================
# WEBHOOK
# ============================================================================
WEBHOOK_VERIFY_TOKEN=your_random_secure_token_here

# ============================================================================
# CORS (Production)
# ============================================================================
# Development: Use * or http://localhost:3000
# Production: Use your actual domain(s), comma-separated
CORS_ORIGINS=*

# ============================================================================
# RATE LIMITING
# ============================================================================
RATELIMIT_LOGIN=5 per minute
RATELIMIT_STORAGE_URI=memory://
# Production: Use Redis for distributed rate limiting
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=

# ============================================================================
# GOOGLE WORKSPACE INTEGRATION
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/integrations/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/drive.readonly
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SYNC_ENABLED=1
GOOGLE_SYNC_INTERVAL_SECONDS=300
GOOGLE_SYNC_GMAIL_MAX_RESULTS=50
GOOGLE_SYNC_CALENDAR_DAYS_BACK=7
GOOGLE_SYNC_CALENDAR_DAYS_FORWARD=30

# ============================================================================
# CUSTOMER PORTAL
# ============================================================================
PORTAL_JWT_SECRET=
PORTAL_JWT_EXP_HOURS=24
PORTAL_BASE_URL=http://localhost:5000/portal

# ============================================================================
# SMTP (Optional - for email notifications)
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
SMTP_FROM_EMAIL=
EMAIL_PROVIDER=smtp
APP_BASE_URL=http://localhost:5000

# ============================================================================
# QUICKBOOKS INTEGRATION
# ============================================================================
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:5000/integrations/quickbooks/callback
QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_MAX_RETRIES=3

# ============================================================================
# PUBLIC API
# ============================================================================
PUBLIC_API_RATE_LIMIT_PER_HOUR=1000
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=3600
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BASE_SECONDS=1
WEBHOOK_SIGNATURE_HEADER=X-WhatsAppCRM-Signature

# ============================================================================
# MEDIA STORAGE
# ============================================================================
MEDIA_UPLOAD_FOLDER=uploads

# ============================================================================
# DOCUMENT MANAGEMENT STORAGE
# ============================================================================
DOCUMENT_MAX_SIZE_MB=50
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_LOCAL_BASE_DIR=uploads/documents
DOCUMENT_S3_ENDPOINT_URL=
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
